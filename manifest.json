{
  "manifest_version": 3,
  "name": "ALPHA - Interface en langue locale (prototype)",
  "version": "0.1.0",
  "icons": {
    "16": "icons/alpha-16.png",
    "32": "icons/alpha-32.png",
    "48": "icons/alpha-48.png",
    "128": "icons/alpha-128.png"
  },
  "description": "Affiche un service financier numérique dans une langue nationale du Cameroun, sans modifier son code source, en protégeant les montants et les informations sensibles.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "https://*.google.com/*",
        "https://*.googleapis.com/*"
      ],
      "css": [
        "src/confidence.css"
      ],
      "js": [
        "src/protect.js",
        "src/engine/common.js",
        "src/engine/templates.js",
        "src/engine/fuzzy.js",
        "src/engine/segments.js",
        "src/engine/rules.js",
        "src/engine/language.js",
        "src/translate.js",
        "src/engine/mt.js",
        "src/translation-controller.js",
        "src/confidence.js",
        "src/guide.js",
        "src/panel-guide.js",
        "src/panel.js",
        "src/voice.js",
        "src/guide-controller.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css",
        "data/dictionary.json",
        "data/critical_terms.json",
        "data/templates.json",
        "data/lexicon.json",
        "data/rules.json",
        "data/guide.json"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
