{
  "manifest_version": 3,
  "name": "SAFINUM - Interface en langue locale (prototype)",
  "version": "0.1.0",
  "description": "Affiche un service financier numérique dans une langue nationale du Cameroun, sans modifier son code source, en protégeant les montants et les informations sensibles.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "https://*.google.com/*",
        "https://*.googleapis.com/*"
      ],
      "css": [
        "src/confidence.css"
      ],
      "js": [
        "src/protect.js",
        "src/engine/templates.js",
        "src/engine/fuzzy.js",
        "src/engine/segments.js",
        "src/engine/rules.js",
        "src/translate.js",
        "src/confidence.js",
        "src/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/dictionary.json",
        "data/critical_terms.json",
        "data/templates.json",
        "data/lexicon.json",
        "data/rules.json"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
