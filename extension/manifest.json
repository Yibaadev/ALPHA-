{
  "manifest_version": 3,
  "name": "ALPHA - Interface en langue locale (prototype)",
  "version": "0.1.0",
  "icons": {
    "16": "icons/alpha-16.png",
    "32": "icons/alpha-32.png",
    "48": "icons/alpha-48.png",
    "128": "icons/alpha-128.png"
  },
  "description": "Affiche un service financier numérique dans une langue nationale du Cameroun, sans modifier son code source, en protégeant les montants et les informations sensibles.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "https://*.google.com/*",
        "https://*.googleapis.com/*"
      ],
      "css": [
        "src/ui/confidence.css"
      ],
      "js": [
        "src/engine/protect.js",
        "src/engine/common.js",
        "src/engine/templates.js",
        "src/engine/fuzzy.js",
        "src/engine/segments.js",
        "src/engine/rules.js",
        "src/engine/language.js",
        "src/engine/translate.js",
        "src/engine/mt.js",
        "src/content/translation-controller.js",
        "src/engine/confidence.js",
        "src/guide/guide.js",
        "src/ui/panel-guide.js",
        "src/ui/panel-read.js",
        "src/ui/panel.js",
        "src/voice/eton-audio.js",
        "src/voice/voice.js",
        "src/guide/guide-controller.js",
        "src/voice/read-mode.js",
        "src/content/page-observer.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/panel.css",
        "src/ui/panel-help.css",
        "data/dictionary.json",
        "data/critical_terms.json",
        "data/templates.json",
        "data/lexicon-valide.json",
        "data/rules.json",
        "data/guide.json",
        "data/audio/eton/index.json",
        "data/audio/eton/omnivoice/*.ogg",
        "data/audio/eton/locuteur/*"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
