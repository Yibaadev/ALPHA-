{"id":"tpl.unseen_confirmez_envoi.partie1","key":"tpl.unseen_confirmez_envoi.partie1","text":"Yə̀ ù jə́blə́ nlóm wà","language_id":"eto","origin":"templates"}
{"id":"tpl.unseen_confirmez_envoi.partie2","key":"tpl.unseen_confirmez_envoi.partie2","text":"á nɔ́mbà","language_id":"eto","origin":"templates"}
{"id":"guide.dashboard.where","key":"guide.dashboard.where","text":"Nlem é kɔ̂nt yɔ̂ : mwàní à lígì yà bísɛ́ ù bòbànyà.","language_id":"eto","origin":"guide"}
{"id":"guide.dashboard.what","key":"guide.dashboard.what","text":"Yén mwàní w’à lígì, ŋgə́ tàdì lóm mwàní.","language_id":"eto","origin":"guide"}
{"id":"guide.dashboard.how","key":"guide.dashboard.how","text":"Ŋgə́ ù yì lóm mwàní, nyì’ì « Lóm mwàní ». Ŋgə́ ù yì tɔ́ŋ yə́m táŋ, nyì’ì « Tál táŋ ».","language_id":"eto","origin":"guide"}
{"id":"guide.fees.where","key":"guide.fees.where","text":"Nlóm mwàní : tɔ́b mwàní w’à lóm yà táŋ.","language_id":"eto","origin":"guide"}
{"id":"guide.fees.what","key":"guide.fees.what","text":"Tɔ́b m̀bə̀b nlóm, ù tíl mwàní w’à lóm. Táŋ yà mwàní wɔ́sə̂ w’à kùì by’à lánbân byə̀ m̀yɛ̌n.","language_id":"eto","origin":"guide"}
{"id":"guide.fees.how","key":"guide.fees.how","text":"Tɔ́b m̀bə̀b á « M̀bə̀b í nlóm », tíl mwàní á « Mwàní ú nlóm », yénègè bèn « Mwàní wɔ́sə̂ wàyá kùì », mbús ù nyì’ì « Kə́lə̀ ósú ».","language_id":"eto","origin":"guide"}
{"id":"guide.beneficiary.where","key":"guide.beneficiary.where","text":"Nlóm mwàní : mòd àtə́ nɔŋ mwàní.","language_id":"eto","origin":"guide"}
{"id":"guide.beneficiary.what","key":"guide.beneficiary.what","text":"Tíl dwé lə̀ mòd àtə́ nɔŋ yà nwàmɔ̀ ŋkwǎl wɔ́, mbús àsú nlóm.","language_id":"eto","origin":"guide"}
{"id":"guide.beneficiary.how","key":"guide.beneficiary.how","text":"Tíl « Dwé lə̀ mòd àtə́ nɔŋ » yà « Nwàmɔ̀ ŋkwǎl ». Búlnì láŋ nwàmɔ̀ nɔ́mbà nɔ́mbà, nyì’ì é kàrà é nə̀ ósúsúâ, mbús ù nyì’ì « Kə́lə̀ ósú ».","language_id":"eto","origin":"guide"}
{"id":"guide.beneficiary.tip","key":"guide.beneficiary.tip","text":"Ŋgə́ nwàmɔ̀ àcɔ́b, mwàní àkə̀ ábə́ mòd ḿfə́.","language_id":"eto","origin":"guide"}
{"id":"guide.summary.where","key":"guide.summary.where","text":"Nlóm mwàní : bə̀’ə̀ yén bísə̂ ósúsúâ nâ ù lóm.","language_id":"eto","origin":"guide"}
{"id":"guide.summary.what","key":"guide.summary.what","text":"Bə̀’ə̀ yén mwàní w’à lóm, táŋ, mwàní wɔ́sə̂ w’à kùì yà mòd àtə́ nɔŋ. Mwàní à ngə́nə́ tà’à kə́.","language_id":"eto","origin":"guide"}
{"id":"guide.summary.how","key":"guide.summary.how","text":"Ŋgə́ bísə̂ bí nə̀ bèn, nyì’ì é kàrà é nə̀ ósúsúâ, mbús ù nyì’ì « Jə́blə́ nlóm mwàní ». Ŋgə́ tà’à nà, nyì’ì « Cɛ́nî ».","language_id":"eto","origin":"guide"}
{"id":"guide.receipt.where","key":"guide.receipt.where","text":"Kálàdà wà ǹyáà : nlóm mwàní ùbòbànyà.","language_id":"eto","origin":"guide"}
{"id":"guide.receipt.what","key":"guide.receipt.what","text":"Bà’àlà nɔ́mbà nlóm mwàní : à yá sál ŋgə́ ù yì bɛ̀bə̀.","language_id":"eto","origin":"guide"}
{"id":"guide.receipt.how","key":"guide.receipt.how","text":"Tíl nɔ́mbà à nə̀ á màn. Ŋgə́ ù yì lóm fə́, nyì’ì « Lóm mwàní fə́ ».","language_id":"eto","origin":"guide"}
{"id":"guide.alert.0","key":"guide.alert.0","text":"Tíl mwàní à dàŋ zérò, mbús ù búlnì və̀gə̀.","language_id":"eto","origin":"guide"}
{"id":"guide.alert.1","key":"guide.alert.1","text":"Mwàní w’à lóm yà táŋ bí dàŋ mwàní wɔ̂ : sùzgá mwàní w’à lóm.","language_id":"eto","origin":"guide"}
{"id":"guide.alert.2","key":"guide.alert.2","text":"Tíl dwé lə̀ mòd àtə́ nɔŋ yà nwàmɔ̀ wɔ́.","language_id":"eto","origin":"guide"}
{"id":"guide.alert.3","key":"guide.alert.3","text":"Búlnì láŋ nwàmɔ̀ mòd àtə́ nɔŋ, mbús ù nyì’ì é kàrà é nə̀ ósúsúâ.","language_id":"eto","origin":"guide"}
{"id":"guide.alert.4","key":"guide.alert.4","text":"Mòd àtə́ nɔŋ ḿfə́ : yə́mègè bèn mòd nû ósúsúâ nâ ù lóm mwàní.","language_id":"eto","origin":"guide"}
{"id":"guide.alert.5","key":"guide.alert.5","text":"Dzɔ̌m dí cɔ́b á ŋkwǎl : yàŋgá mɔ́n ìtə̀ŋ, mbús ù búlnì və̀gə̀.","language_id":"eto","origin":"guide"}
{"id":"guide.alert.6","key":"guide.alert.6","text":"Nyì’ì é kàrà é nə̀ ósúsúâ nâ ù jə́blə́ nlóm mwàní.","language_id":"eto","origin":"guide"}
{"id":"guide.ui.where","key":"guide.ui.where","text":"Mə̀ nə̀ vé ?","language_id":"eto","origin":"guide"}
{"id":"guide.ui.what","key":"guide.ui.what","text":"Mə̀ bɔ̀ dzé ?","language_id":"eto","origin":"guide"}
{"id":"guide.ui.how","key":"guide.ui.how","text":"Mə̀ bɔ̀ yá ?","language_id":"eto","origin":"guide"}
{"id":"guide.ui.alert","key":"guide.ui.alert","text":"Fɔ̀ é nə̀ á màn","language_id":"eto","origin":"guide"}
{"id":"guide.ui.known","key":"guide.ui.known","text":"B’à tílí lédég di ású màn má.","language_id":"eto","origin":"guide"}
{"id":"guide.ui.unknownalert","key":"guide.ui.unknownAlert","text":"Láŋgá fɔ̀ ní ósúsúâ nâ ù kə̀ ósú.","language_id":"eto","origin":"guide"}
{"id":"guide.ui.secrettip","key":"guide.ui.secretTip","text":"Nɔ́mbà ní à nə̀ àswé : tə̀ ù kàt mòd mɔ́s, tɔ́ mòd à kàt nâ bâŋ à lóm ɲə́.","language_id":"eto","origin":"guide"}
{"id":"intro.title","key":"intro.title","text":"Mə̀ nə̀ ALPHA !","language_id":"eto","origin":"guide"}
{"id":"intro.line.0","key":"intro.line.0","text":"Mə̀ tə̀ yɛ̀ŋ á yɔ́b, vè mànɔ́mbà mɔ̂ mə̀ tə́ fɔ́’ɔ́ té.","language_id":"eto","origin":"guide"}
{"id":"intro.line.1","key":"intro.line.1","text":"Mə̀ tə̀ kɔ̀bɔ̀ màn má á flànsí, íŋglís, ŋgə́ étón, tə̀ nàm mwàní wɔ̂, mànɔ́mbà mɔ̂, ŋgə́ móy mɔ̂.","language_id":"eto","origin":"guide"}
{"id":"intro.line.2","key":"intro.line.2","text":"Nyì’ì mə́ ású yɛ́n bìsɛ́ byâm. Tìndgá mə́ ŋgə́ mə̀ tə̀ ù kwàm : mə̀ bə́gə̀ bə̀ ɔ̀lùn.","language_id":"eto","origin":"guide"}
{"id":"intro.about","key":"intro.about","text":"Fùlàgì ní à tə̀ yɛ̀ŋ á yɔ́b, à nə̀ dzé ?","language_id":"eto","origin":"guide"}
{"id":"intro.ok","key":"intro.ok","text":"Mə̀wógí !","language_id":"eto","origin":"guide"}
{"id":"gloss.fees.text","key":"gloss.fees.text","text":"Mwàní ísɛ́ y’à nɔŋ ású bòbàn ísɛ́. À tə̀ bàmàn á mwàní w’à lóm. Ŋgə́ mwàní w’à lóm à nɛ́n, táŋ y’à nɛ́n fə́, vè à nə̀ àbùm ìtún yà ǹnɛ́n.","language_id":"eto","origin":"glossary"}
{"id":"gloss.balance_after.text","key":"gloss.balance_after.text","text":"Mwàní à yá lígì á kɔ̂nt yɔ̂ á mbús b’à nɔŋ mwàní w’à lóm yà táŋ.","language_id":"eto","origin":"glossary"}
{"id":"gloss.balance.text","key":"gloss.balance.text","text":"Mwàní ú nə̀ á kɔ̂nt yɔ̂ ɛ́yə́ŋ ní. Ù bə́gə̀ dzàm lóm mwàní à dàŋ mwàní nû, ŋgə́ ù bàmàn táŋ.","language_id":"eto","origin":"glossary"}
{"id":"gloss.beneficiary.text","key":"gloss.beneficiary.text","text":"Mòd àtə́ nɔŋ mwàní. Cázgá dwé lɔ́ yà nwàmɔ̀ wɔ́ : ŋgə́ mwàní àkə̀ ábə́ mòd ḿfə́, ànə̀ àyà nâ ù búlnì nɔŋ ɲə́.","language_id":"eto","origin":"glossary"}
{"id":"gloss.new_beneficiary.term","key":"gloss.new_beneficiary.term","text":"Mòd àtə́ nɔŋ ḿfə́","language_id":"eto","origin":"glossary"}
{"id":"gloss.new_beneficiary.text","key":"gloss.new_beneficiary.text","text":"Ù bə́gə̀ kə́ lóm mwàní á nwàmɔ̀ nû á kɔ̂nt yɔ̂ mɔ́s mɔ́s. Màdúgà mə̀tə̀ bɔ̀ nálá : yə̀mgá mbə̀ŋ nâ ù yə́m mòd nû.","language_id":"eto","origin":"glossary"}
{"id":"gloss.reference.text","key":"gloss.reference.text","text":"Nɔ́mbà wùá àtə̀ lə́d ísɛ́ yɔ̂. Bàglà ɲə́ : àtə̀ lə́d nâ ù lómnyà mwàní ŋgə́ àtə̀ sál ású bɛ̀bə̀.","language_id":"eto","origin":"glossary"}
{"id":"gloss.amount.text","key":"gloss.amount.text","text":"Mwàní mòd àtə́ nɔŋ àyá nɔŋ, tə̀ táŋ.","language_id":"eto","origin":"glossary"}
{"id":"gloss.total_debit.text","key":"gloss.total_debit.text","text":"Mwàní wɔ́sə̂ ùkùì á kɔ̂nt yɔ̂ : àbùm mwàní ú nlóm yà táŋ.","language_id":"eto","origin":"glossary"}
{"id":"gloss.debit.term","key":"gloss.debit.term","text":"Mwàní ùkùì","language_id":"eto","origin":"glossary"}
{"id":"gloss.debit.text","key":"gloss.debit.text","text":"Mwàní ùkùì á kɔ̂nt yɔ̂. Ìfə́ yà ǹnɔ́ŋí : mwàní ùnyíì á kɔ̂nt yɔ̂.","language_id":"eto","origin":"glossary"}
{"id":"gloss.reason.text","key":"gloss.reason.text","text":"Ìbùg ìtún ású kàt àsú ú mwàní (ndá, ǹdá bɔ̀d, kálàdà…). Yátə̀ sál ású yɛ́n ísɛ́ ńì á mbús.","language_id":"eto","origin":"glossary"}
{"id":"gloss.operation_type.text","key":"gloss.operation_type.text","text":"Ǹzə̌n yà lóm mwàní : á kɔ̂nt yà ísɛ́ ńì, á Mobile Money, ŋgə́ á báŋk ìfə́. Táŋ àtə̀ cɛ́nî á mbús ǹtɔ́b wɔ̂.","language_id":"eto","origin":"glossary"}
{"id":"gloss.mobile_money.term","key":"gloss.mobile_money.term","text":"Mobile Money","language_id":"eto","origin":"glossary"}
{"id":"gloss.mobile_money.text","key":"gloss.mobile_money.text","text":"Kɔ̂nt yà mwàní ìbàmàn á nwàmɔ̀ ŋkwǎl, ísɛ́ yà ŋkwǎl yátə̀ sál ɲə́. Mwàní àtə̀ kə̀ á tɛ̀lɛ̀fɔ̂n yà mòd àtə́ nɔŋ.","language_id":"eto","origin":"glossary"}
{"id":"gloss.other_bank.text","key":"gloss.other_bank.text","text":"Nlóm mwàní á kɔ̂nt yà báŋk ìfə́. Àtə̀ bə̀ ǹtáŋ á yɔ́b yà ǹtə̀ŋ àyà.","language_id":"eto","origin":"glossary"}
{"id":"gloss.account_number.term","key":"gloss.account_number.term","text":"Nwàmɔ̀ kɔ̂nt","language_id":"eto","origin":"glossary"}
{"id":"gloss.account_number.text","key":"gloss.account_number.text","text":"Nɔ́mbà àtə̀ lə́d kɔ̂nt yɔ̂. Kàtgá ɲə́ vè bɔ̀d bə̀tə̀ lóm wɔ̀ mwàní.","language_id":"eto","origin":"glossary"}
{"id":"gloss.transfer.term","key":"gloss.transfer.term","text":"Nlóm mwàní","language_id":"eto","origin":"glossary"}
{"id":"gloss.transfer.text","key":"gloss.transfer.text","text":"Lóm mwàní á kɔ̂nt yɔ̂ á kə̀ á kɔ̂nt yà mòd ḿfə́. Ŋgə́ ù jə́blə́nyà, ù bə́gə̀ dzàm kàb ɲə́ fə́.","language_id":"eto","origin":"glossary"}
{"id":"gloss.instant.term","key":"gloss.instant.term","text":"Àvəl àvəl","language_id":"eto","origin":"glossary"}
{"id":"gloss.instant.text","key":"gloss.instant.text","text":"Mwàní àtə̀ kə̀ ábə́ mòd àtə́ nɔŋ á ǹtə̀ŋ mɔ́n, tə̀ yàŋà mə̀lú.","language_id":"eto","origin":"glossary"}
{"id":"gloss.summary.text","key":"gloss.summary.text","text":"Ìbɛ̀bə̀ ísɛ́ ósúsúâ nâ ù lóm. Mwàní àbə́gə̀ kə̀ : ànə̀ ǹtə̀ŋ àsú kɔ̀m dzɔ̌m díŋgá cɔ́b.","language_id":"eto","origin":"glossary"}
{"id":"gloss.receipt.term","key":"gloss.receipt.term","text":"Kálàdà wà ǹyáà","language_id":"eto","origin":"glossary"}
{"id":"gloss.receipt.text","key":"gloss.receipt.text","text":"Kálàdà àtə̀ lə́d nâ ísɛ́ ìbòbànyà. Bàglà ɲə́, yà nɔ́mbà yà ísɛ́.","language_id":"eto","origin":"glossary"}
{"id":"gloss.status.text","key":"gloss.status.text","text":"M̀bə̀b í ísɛ́ : ìbòbànyà mbə̀ŋ, ìtə̀ yàŋà, ŋgə́ ìŋgá cɔ́b.","language_id":"eto","origin":"glossary"}
{"id":"gloss.secret_code.term","key":"gloss.secret_code.term","text":"Nɔ́mbà yà ǹsɔ́l","language_id":"eto","origin":"glossary"}
{"id":"gloss.secret_code.text","key":"gloss.secret_code.text","text":"Nɔ́mbà wɔ̂ àtə̀ lə́d nâ à nə̀ wɔ̀. Tə̀ ù kàt mòd ḿfə́ mɔ́s mɔ́s, tɔ́ mòd àkàt nâ bâŋ àlóm ɲə́.","language_id":"eto","origin":"glossary"}
{"id":"gloss.security_alert.text","key":"gloss.security_alert.text","text":"Fɔ̀ ńlɔ́ŋí àtə̀ lə́d dzɔ̌m díbə́gə̀ mbə̀ŋ. Láŋgá ɲə́ wɔ́sə̂, ù cázgá dzɔ̌m àtə̀ yì ósúsúâ nâ ù kə̀ ósú.","language_id":"eto","origin":"glossary"}
{"id":"gloss.secure_connection.text","key":"gloss.secure_connection.text","text":"Màm mə̀tə̀ kə̀ á zàŋ tɛ̀lɛ̀fɔ̂n yɔ̂ yà ísɛ́ mánə̀ ǹsɔ́l. Bì bə́gə̀ lə́d nâ mòd àtə́ nɔŋ ànə̀ mbə̀ŋ : cázgá ɲə́ ngə́d ísə̂.","language_id":"eto","origin":"glossary"}
{"id":"gloss.merchant_payment.text","key":"gloss.merchant_payment.text","text":"Èyágná ábə́ mòd àtə̀ kùz bìyɔ́m á kɔ̂nt yɔ̂.","language_id":"eto","origin":"glossary"}
{"id":"gloss.free.text","key":"gloss.free.text","text":"Bə̀bə́gə̀ nɔŋ táŋ : mwàní wɔ́sə̂ ùkùì ànə̀ fàlà àbùm mwàní ú nlóm.","language_id":"eto","origin":"glossary"}
{"id":"gloss.ui.button","key":"gloss.ui.button","text":"Lédég","language_id":"eto","origin":"glossary"}
{"id":"gloss.ui.listen","key":"gloss.ui.listen","text":"Vòglò","language_id":"eto","origin":"glossary"}
{"id":"gloss.ui.hint","key":"gloss.ui.hint","text":"Fɛ́g : tɔ́’ɔ̀ éfia jìá é nə̀ á màn (táŋ, mwàní, mòd àtə́ nɔŋ…) ású yɛ́n lédég wɔ́.","language_id":"eto","origin":"glossary"}
